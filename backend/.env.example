SMTP_PASSWORD=your-smtp-app-password-16-chars
SMTP_PORT=587
SMTP_USER=your-smtp-email@gmail.com
FRONTEND_URL=https://tms-task-mangement-system.vercel.app
MASTER_USER=master
MASTER_PASSWORD=your-master-password
GOOGLE_SHEETS_CREDENTIALS_PATH=backend/secrets/tms-service-account.json
